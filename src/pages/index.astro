---
import { Alert, AlertDescription, AlertTitle } from "../components/ui/alert.js";
import { buttonVariants } from "../components/ui/button.js";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
} from "../components/ui/card.js";
import { EmptyState } from "../components/ui/empty-state.js";
import { StatusBadge } from "../components/ui/status-badge.js";
import AppLayout from "../layouts/AppLayout.astro";
import {
  listProjects,
  PROJECT_STATUSES,
  type ProjectStatus,
} from "../server/projects.js";

const requestedStatus = Astro.url.searchParams.get("status");
const status = PROJECT_STATUSES.includes(requestedStatus as ProjectStatus)
  ? (requestedStatus as ProjectStatus)
  : undefined;
const projects = listProjects(status);
const deleted = Astro.url.searchParams.get("deleted") === "1";
const filters: Array<{ label: string; value?: ProjectStatus }> = [
  { label: "All" },
  { label: "Planned", value: "planned" },
  { label: "Active", value: "active" },
  { label: "Done", value: "done" },
];
---

<AppLayout title="Projects">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">
        Reference feature
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
        Projects
      </h1>
      <p class="mt-2 max-w-2xl text-muted-foreground">
        A complete example of pages, Actions, validation, SQLite, and responsive
        UI.
      </p>
    </div>
    <a class:list={[buttonVariants(), "shrink-0"]} href="/projects/new"
      >New project</a
    >
  </div>

  {
    deleted && (
      <Alert className="mt-6" variant="success" role="status">
        <AlertTitle>Project deleted</AlertTitle>
        <AlertDescription>The project was removed.</AlertDescription>
      </Alert>
    )
  }

  <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filter projects">
    {
      filters.map((filter) => (
        <a
          href={filter.value ? `/?status=${filter.value}` : "/"}
          aria-current={status === filter.value ? "page" : undefined}
          class:list={[
            buttonVariants({
              variant: status === filter.value ? "default" : "outline",
              size: "sm",
            }),
            "rounded-full",
          ]}
        >
          {filter.label}
        </a>
      ))
    }
  </nav>

  <section class="mt-6" aria-label="Project list">
    {
      projects.length === 0 ? (
        <EmptyState />
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <a
              class="group text-foreground no-underline"
              href={`/projects/${project.id}`}
            >
              <Card className="h-full transition hover:-translate-y-0.5 hover:ring-primary/35 hover:shadow-md">
                <CardHeader className="grid-cols-[1fr_auto]">
                  <h2 class="font-semibold group-hover:text-primary">
                    {project.name}
                  </h2>
                  <StatusBadge status={project.status} />
                </CardHeader>
                <CardContent className="grow">
                  <p class="line-clamp-3 min-h-10 text-sm leading-6 text-muted-foreground">
                    {project.description || "No description yet."}
                  </p>
                </CardContent>
                <CardFooter>
                  <p class="text-xs text-muted-foreground">
                    Updated{" "}
                    {new Date(project.updatedAt).toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </p>
                </CardFooter>
              </Card>
            </a>
          ))}
        </div>
      )
    }
  </section>
</AppLayout>
