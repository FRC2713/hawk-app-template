---
import { actions } from "astro:actions";
import { ProjectForm } from "../../components/islands/ProjectForm.js";
import {
  Alert,
  AlertDescription,
  AlertTitle,
} from "../../components/ui/alert.js";
import { Card, CardContent } from "../../components/ui/card.js";
import AppLayout from "../../layouts/AppLayout.astro";

const result = Astro.getActionResult(actions.createProject);
if (result?.data?.id) {
  return Astro.redirect(`/projects/${result.data.id}?created=1`, 303);
}
---

<AppLayout title="New project">
  <a
    href="/"
    class="text-sm font-semibold text-muted-foreground no-underline hover:text-foreground"
    >← Projects</a
  >
  <div class="mt-5 max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight">Create a project</h1>
    <p class="mt-2 text-muted-foreground">
      This writes through a validated Astro Action into local SQLite.
    </p>
    {
      result?.error && (
        <div class="mt-6">
          <Alert variant="destructive">
            <AlertTitle>Could not create the project</AlertTitle>
            <AlertDescription>{result.error.message}</AlertDescription>
          </Alert>
        </div>
      )
    }
    <Card className="mt-8 py-6 sm:py-8">
      <CardContent>
        <ProjectForm client:load mode="create" />
      </CardContent>
    </Card>
  </div>
</AppLayout>
