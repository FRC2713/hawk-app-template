---
import { actions } from "astro:actions";
import { DeleteProjectDialog } from "../../components/islands/DeleteProjectDialog.js";
import {
  Alert,
  AlertDescription,
  AlertTitle,
} from "../../components/ui/alert.js";
import { buttonVariants } from "../../components/ui/button.js";
import { Card, CardContent, CardHeader } from "../../components/ui/card.js";
import { Separator } from "../../components/ui/separator.js";
import { StatusBadge } from "../../components/ui/status-badge.js";
import AppLayout from "../../layouts/AppLayout.astro";
import { getProject } from "../../server/projects.js";

const id = Number(Astro.params.id);
const project = Number.isSafeInteger(id) && id > 0 ? getProject(id) : undefined;
if (!project) return new Response("Project not found", { status: 404 });

const deleteResult = Astro.getActionResult(actions.deleteProject);
if (deleteResult?.data?.ok) return Astro.redirect("/?deleted=1", 303);
const created = Astro.url.searchParams.get("created") === "1";
const updated = Astro.url.searchParams.get("updated") === "1";
---

<AppLayout
  title={project.name}
  description={project.description || project.name}
>
  <a
    href="/"
    class="text-sm font-semibold text-muted-foreground no-underline hover:text-foreground"
    >← Projects</a
  >

  {
    (created || updated) && (
      <div class="mt-6">
        <Alert variant="success" role="status">
          <AlertTitle>Project {created ? "created" : "updated"}</AlertTitle>
          <AlertDescription>Your changes were saved.</AlertDescription>
        </Alert>
      </div>
    )
  }
  {
    deleteResult?.error && (
      <div class="mt-6">
        <Alert variant="destructive">
          <AlertTitle>Could not delete the project</AlertTitle>
          <AlertDescription>{deleteResult.error.message}</AlertDescription>
        </Alert>
      </div>
    )
  }

  <Card className="mt-6 py-6 sm:py-8">
    <CardHeader
      className="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between"
    >
      <div>
        <StatusBadge status={project.status} />
        <h1 class="mt-4 text-3xl font-bold tracking-tight">{project.name}</h1>
      </div>
      <a
        class={buttonVariants({ variant: "outline" })}
        href={`/projects/${project.id}/edit`}>Edit project</a
      >
    </CardHeader>

    <CardContent className="gap-8">
      <Separator />
      <div>
        <h2
          class="text-sm font-semibold uppercase tracking-[0.14em] text-muted-foreground"
        >
          Description
        </h2>
        <p class="mt-3 whitespace-pre-wrap leading-7 text-foreground">
          {project.description || "No description yet."}
        </p>
      </div>

      <Separator />
      <dl class="grid gap-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="font-semibold text-muted-foreground">Created</dt>
          <dd class="mt-1">{new Date(project.createdAt).toLocaleString()}</dd>
        </div>
        <div>
          <dt class="font-semibold text-muted-foreground">Last updated</dt>
          <dd class="mt-1">{new Date(project.updatedAt).toLocaleString()}</dd>
        </div>
      </dl>
    </CardContent>
  </Card>

  <section class="mt-8 rounded-xl border border-destructive/30 bg-card p-6">
    <h2 class="font-semibold">Danger zone</h2>
    <p class="mt-1 text-sm text-muted-foreground">Deletion cannot be undone.</p>
    <div class="mt-4">
      <DeleteProjectDialog client:load id={project.id} name={project.name} />
    </div>
  </section>
</AppLayout>
