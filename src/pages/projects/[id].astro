---
import { actions } from "astro:actions";
import { DeleteProjectDialog } from "../../components/islands/DeleteProjectDialog.js";
import Alert from "../../components/ui/Alert.astro";
import StatusBadge from "../../components/ui/StatusBadge.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getProject } from "../../server/projects.js";

const id = Number(Astro.params.id);
const project = Number.isSafeInteger(id) && id > 0 ? getProject(id) : undefined;
if (!project) return new Response("Project not found", { status: 404 });

const deleteResult = Astro.getActionResult(actions.deleteProject);
if (deleteResult?.data?.ok) return Astro.redirect("/?deleted=1", 303);
const created = Astro.url.searchParams.get("created") === "1";
const updated = Astro.url.searchParams.get("updated") === "1";
---

<AppLayout
  title={project.name}
  description={project.description || project.name}
>
  <a
    href="/"
    class="text-sm font-semibold text-muted no-underline hover:text-ink"
    >← Projects</a
  >

  {
    (created || updated) && (
      <div class="mt-6">
        <Alert tone="success">Project {created ? "created" : "updated"}.</Alert>
      </div>
    )
  }
  {
    deleteResult?.error && (
      <div class="mt-6">
        <Alert tone="error">{deleteResult.error.message}</Alert>
      </div>
    )
  }

  <article class="mt-6 rounded-2xl border bg-white p-6 shadow-sm sm:p-8">
    <div
      class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between"
    >
      <div>
        <StatusBadge status={project.status} />
        <h1 class="mt-4 text-3xl font-bold tracking-tight">{project.name}</h1>
      </div>
      <a class="button button-secondary" href={`/projects/${project.id}/edit`}
        >Edit project</a
      >
    </div>

    <div class="mt-8 border-t pt-8">
      <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-muted">
        Description
      </h2>
      <p class="mt-3 whitespace-pre-wrap leading-7 text-ink">
        {project.description || "No description yet."}
      </p>
    </div>

    <dl class="mt-8 grid gap-4 border-t pt-8 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-semibold text-muted">Created</dt>
        <dd class="mt-1">{new Date(project.createdAt).toLocaleString()}</dd>
      </div>
      <div>
        <dt class="font-semibold text-muted">Last updated</dt>
        <dd class="mt-1">{new Date(project.updatedAt).toLocaleString()}</dd>
      </div>
    </dl>
  </article>

  <section class="mt-8 rounded-2xl border border-danger-line bg-white p-6">
    <h2 class="font-semibold">Danger zone</h2>
    <p class="mt-1 text-sm text-muted">Deletion cannot be undone.</p>
    <div class="mt-4">
      <DeleteProjectDialog client:load id={project.id} name={project.name} />
    </div>
  </section>
</AppLayout>
