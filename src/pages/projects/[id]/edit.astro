---
import { actions } from "astro:actions";
import { ProjectForm } from "../../../components/islands/ProjectForm.js";
import {
  Alert,
  AlertDescription,
  AlertTitle,
} from "../../../components/ui/alert.js";
import { Card, CardContent } from "../../../components/ui/card.js";
import AppLayout from "../../../layouts/AppLayout.astro";
import { getProject } from "../../../server/projects.js";

const id = Number(Astro.params.id);
const project = Number.isSafeInteger(id) && id > 0 ? getProject(id) : undefined;
if (!project) return new Response("Project not found", { status: 404 });

const result = Astro.getActionResult(actions.updateProject);
if (result?.data?.id) {
  return Astro.redirect(`/projects/${result.data.id}?updated=1`, 303);
}
---

<AppLayout title={`Edit ${project.name}`}>
  <a
    href={`/projects/${project.id}`}
    class="text-sm font-semibold text-muted-foreground no-underline hover:text-foreground"
  >
    ← {project.name}
  </a>
  <div class="mt-5 max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight">Edit project</h1>
    <p class="mt-2 text-muted-foreground">
      The same Action and repository paths serve enhanced and no-JavaScript
      submissions.
    </p>
    {
      result?.error && (
        <div class="mt-6">
          <Alert variant="destructive">
            <AlertTitle>Could not save the project</AlertTitle>
            <AlertDescription>{result.error.message}</AlertDescription>
          </Alert>
        </div>
      )
    }
    <Card className="mt-8 py-6 sm:py-8">
      <CardContent>
        <ProjectForm client:load mode="update" project={project} />
      </CardContent>
    </Card>
  </div>
</AppLayout>
