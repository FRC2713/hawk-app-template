---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A self-contained web application built from the Hawk App Template.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Hawk App</title>
  </head>
  <body>
    <header class="border-b bg-white">
      <div
        class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4"
      >
        <a href="/" class="flex items-center gap-3 text-ink no-underline">
          <span
            aria-hidden="true"
            class="grid size-9 place-items-center rounded-xl bg-brand font-bold text-white"
            >H</span
          >
          <span>
            <strong class="block text-sm leading-tight">Hawk App</strong>
            <span class="block text-xs text-muted">Local-first starter</span>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" class="text-sm font-semibold text-muted hover:text-ink"
            >Projects</a
          >
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl px-5 py-8 sm:py-12">
      <slot />
    </main>
    <footer class="mx-auto max-w-5xl px-5 py-8 text-xs text-muted">
      Replace this example with your application. Start with <code
        >START_HERE.md</code
      >.
    </footer>
  </body>
</html>
